	measure 'Days to Enrol from Target (Text)' =
			
			VAR _allSel =
			    COUNTROWS ( ALLSELECTED ( _Services[Short Name] ) )
			        = COUNTROWS ( ALL ( _Services[Short Name] ) )
			VAR TargetDays  = [Conversion Speed Average (all)]
			VAR CurrentDays = [Average Days to Enroll from Tour]
			VAR GapDays     = CurrentDays - TargetDays
			VAR NeededDays  = CEILING ( MAX ( 0, GapDays ), 1 )
			RETURN
			SWITCH (
			    TRUE (),
			    _allSel,                                            "All Centres Selected",
			    OR ( ISBLANK ( TargetDays ), ISBLANK ( CurrentDays ) ),
			                                                        "Adjustment Required: N/A",
			    GapDays <= 0,                                       "On Target",
			    "Adjustment Required: " &
			        FORMAT ( NeededDays, "0" ) &
			        " day" & IF ( NeededDays = 1, "", "s" )
			)
		lineageTag: 8ae585fd-c34c-4d4d-b0f4-ffc8d13a42e0

	measure 'Pipeline Focus (Text)' = ```
			
			VAR EnqVal  = [EnqToTour Conversion Rate]
			VAR EnqTgt  = [EnqToTour Conversion Average]
			VAR TourVal = [TourConversionRate]
			VAR TourTgt = [Tour Conversion Average]
			
			-- Detect "All" on the _Services[Short Name] slicer
			VAR AllSel =
			    COUNTROWS ( ALLSELECTED ( _Services[Short Name] ) )
			        = COUNTROWS ( ALL ( _Services[Short Name] ) )
			
			VAR HasBlank = ISBLANK(EnqVal) || ISBLANK(EnqTgt) || ISBLANK(TourVal) || ISBLANK(TourTgt)
			
			VAR EnqOK  = NOT ISBLANK(EnqVal)  && NOT ISBLANK(EnqTgt)  && EnqVal  >= EnqTgt
			VAR TourOK = NOT ISBLANK(TourVal) && NOT ISBLANK(TourTgt) && TourVal >= TourTgt
			
			-- distance to target (percentage points on 0..1 scale)
			VAR EnqGap  = IF(HasBlank, BLANK(), MAX(0, EnqTgt  - EnqVal))
			VAR TourGap = IF(HasBlank, BLANK(), MAX(0, TourTgt - TourVal))
			RETURN
			SWITCH (
			    TRUE(),
			    AllSel,                                 "All Centres Selected",
			    HasBlank,                               "N/A",
			    EnqOK && NOT TourOK,                    "Improve Tour Conversions",
			    NOT EnqOK && TourOK,                    "Improve Enquiry Conversions",
			    NOT EnqOK && NOT TourOK && EnqGap >  TourGap, "Improve Enquiry Conversions",
			    NOT EnqOK && NOT TourOK && TourGap > EnqGap,  "Improve Tour Conversions",
			    NOT EnqOK && NOT TourOK,                "Improve Both",
			    "On Target"
			)
			
			```
		lineageTag: f554a08a-c7e0-45ef-bcf4-6af42c8fab7a

	measure 'EnqToTour  Conversion Calculation Card' =
			
			VAR ToursRaw = [Count Tours Scheduled (Enquired)]
			VAR EnqRaw   = [Count Enquiries]
			VAR Tours    = COALESCE ( ToursRaw, 0 )
			VAR Enq      = COALESCE ( EnqRaw, 0 )
			RETURN
			SWITCH (
			    TRUE (),
			    Enq = 0 && Tours = 0, "No enquiries or tours booked yet.",
			    Enq = 0,              "0 tours booked (no enquiries).",
			    Tours = 0,            "0 tours booked from " & FORMAT ( Enq, "#,0" ) & " enquiries.",
			    FORMAT ( Tours, "#,0" ) & " " & IF ( Tours = 1, "tour", "tours" ) &
			        " booked from " &
			        FORMAT ( Enq, "#,0" ) & " " & IF ( Enq = 1, "enquiry", "enquiries" ) & "."
			)
		lineageTag: 33ba37fe-0f56-4283-abd3-300670db6c49

	measure 'Tour Conversion Calculation Card' =
			
			VAR EnrolRaw = [Conv'd Tour (combined)]
			VAR ToursRaw = [CompletedTours]
			VAR Enrol    = COALESCE ( EnrolRaw, 0 )
			VAR Tours    = COALESCE ( ToursRaw, 0 )
			RETURN
			SWITCH (
			    TRUE (),
			    Tours = 0 && Enrol = 0, "No tours or enrollments yet.",
			    Tours = 0,              "0 enrollments (no tours completed).",
			    FORMAT ( Enrol, "#,0" ) & " " & IF ( Enrol = 1, "enrollment", "enrollments" ) &
			        " from " &
			        FORMAT ( Tours, "#,0" ) & " " & IF ( Tours = 1, "tour", "tours" ) & "."
			)
		lineageTag: aaf1da63-feb9-4f45-bcd0-272c037ef95a

	measure 'Tour Completed In Range' =
			
			VAR SelectedStart =
			    MIN ( '_Date'[Date] )
			VAR SelectedEnd =
			    MAX ( '_Date'[Date] )
			RETURN
			IF (
			    NOT ISBLANK ( SelectedStart )
			        && NOT ISBLANK ( SelectedEnd )
			        && MAX ( 'LineLeader_Updates'[Date Tour Completed (LLTasks)] ) >= SelectedStart
			        && MAX ( 'LineLeader_Updates'[Date Tour Completed (LLTasks)] ) <= SelectedEnd,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 0dfd9942-cf50-4116-8c31-5159a94187b7

	measure 'Children Enrolled' =
			
			VAR MinDate = MIN ( _date[Date] )
			VAR MaxDate = MAX ( _date[Date] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( LineLeader_Updates[child_id] ),
			    LineLeader_Updates[type] = "Status",
			    LineLeader_Updates[to] IN { "4", "6" },
			    NOT ( ISBLANK ( LineLeader_Updates[Date Tour Completed (LLTasks)] ) ),
			    LineLeader_Updates[Date Tour Completed (LLTasks)] >= MinDate,
			    LineLeader_Updates[Date Tour Completed (LLTasks)] <= MaxDate,
			    ALL ( LineLeader_Updates )
			)
		formatString: 0
		lineageTag: a8288e0b-b2ff-4242-b0ec-c1acd8ea59f8

	measure 'Enrollments In Range' =
			
			VAR SelectedStart =
			    MIN ( '_Date'[Date] )
			VAR SelectedEnd =
			    MAX ( '_Date'[Date] )
			RETURN
			IF (
			    NOT ISBLANK ( SelectedStart )
			        && NOT ISBLANK ( SelectedEnd )
			        && (MAX ( 'LineLeader_Updates'[Date Enrolled] ) >= SelectedStart
			        && MAX ( 'LineLeader_Updates'[Date Enrolled] ) <= SelectedEnd) ||
			         (MAX ( 'LineLeader_Updates'[Date Tour Completed (LLTasks)] ) >= SelectedStart
			        && MAX ( 'LineLeader_Updates'[Date Tour Completed (LLTasks)] ) <= SelectedEnd),
			    1,
			    0
			)
		formatString: 0
		lineageTag: c014072f-2355-4ffd-8c39-f017d8db86e2

	partition _Measures = m
		mode: import
		queryGroup: Combined
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Measures = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Measures", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Measures"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

