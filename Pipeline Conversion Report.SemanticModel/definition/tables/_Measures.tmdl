	measure 'EnqToTour Conversions from Target (Text)' =
			
			
			VAR _allSel =
			    COUNTROWS ( ALLSELECTED ( _Services[Short Name] ) )
			        = COUNTROWS ( ALL ( _Services[Short Name] ) )
			VAR TargetRate       = COALESCE ( [EnqToTour Conversion Average], 0 )
			VAR Enquiries        = COALESCE ( [Count Enquiries], 0 )
			VAR Conversions      = COALESCE ( [Count Tours Scheduled (Enquired)], 0 )
			VAR RequiredAtTarget = TargetRate * Enquiries
			VAR Gap              = RequiredAtTarget - Conversions
			RETURN
			SWITCH (
			    TRUE (),
			    _allSel,                                     "All Centres Selected",
			    Enquiries = 0 || TargetRate <= 0,            "Conversions to reach target: 0",
			    Gap <= 0,                                     "On Target",
			    "Conversions to reach target: " & FORMAT ( CEILING ( MAX ( 0, Gap ), 1 ), "0" )
			)
		lineageTag: dfc42826-b154-4eb7-82bb-75b344ea9045

