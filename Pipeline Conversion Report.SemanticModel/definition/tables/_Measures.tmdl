	measure ConversionPercentileSummary =
			
			VAR MinDate = MIN(_Date[Date])
			VAR MaxDate = MAX(_Date[Date])
			VAR SelectedStart = FORMAT(MinDate, "d MMM yyyy")
			VAR SelectedEnd = FORMAT(MaxDate, "d MMM yyyy")
			
			VAR SelectedPercent = [SelectedPercentile] * 100
			VAR RoundedPercent = ROUND(SelectedPercent, 0)
			
			VAR DaysToConvert = [SelectedThreshold_DaysOrPercentile]
			VAR DayLabel = IF(DaysToConvert = 1, " day", " days")
			
			RETURN
			IF(
			    ISBLANK(DaysToConvert),
			    "No conversion data available for the selected period.",
			    "From " & SelectedStart & " to " & SelectedEnd &
			    ", it took " & DaysToConvert & DayLabel &
			    " to complete " & RoundedPercent & "% of conversions"
			)
		lineageTag: f6283f92-5cae-48c6-b3e5-040e3fdcb506

	measure SelectedThreshold_DaysOrPercentile = ```
			
			SWITCH(
			    SELECTEDVALUE(ConversionViewMode[Mode]),
			    "Percent", [DaysToReachPercentile],        -- From your earlier measure
			    "Days", MAX(DaysSlider[Value]),            -- Value selected by user directly
			    BLANK()
			)
			
			```
		lineageTag: ba756d16-ae2d-4c18-b5ed-bd30c6ff8e94

	measure DaysToReachPercentile = ```
			
			VAR Total =
			    CALCULATE(
			        COUNTROWS(TourToConversionPairs)
			    )
			
			RETURN
			MINX(
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(TourToConversionPairs[DaysElapsed]),
			            "CumulativePercent", 
			            VAR CurrentDay = [DaysElapsed]
			            VAR RunningTotal = 
			                CALCULATE(
			                    COUNTROWS(TourToConversionPairs),
			                    FILTER(
			                        TourToConversionPairs,
			                        TourToConversionPairs[DaysElapsed] <= CurrentDay
			                    )
			                )
			            RETURN DIVIDE(RunningTotal, Total)
			        ),
			        [CumulativePercent] >= [SelectedPercentile]
			    ),
			    [DaysElapsed]
			)
			
			```
		formatString: 0
		lineageTag: b6a19aa3-bfc3-43ff-98eb-f3ce2fad583b

	measure 'Tour Conversion Vs Last Year' =
			
			VAR IsMonthSelected = COUNTROWS(VALUES(_Date[Year-Month])) = 1
			VAR IsQuarterSelected = COUNTROWS(VALUES(_Date[Fiscal Month])) = 1
			VAR IsYearSelected = COUNTROWS(VALUES(_Date[Fiscal Year Name])) = 1
			
			VAR ThisPeriodTours = [EnqToTour Conversion Rate]
			
			VAR LastPeriodTours =
			    SWITCH(
			        TRUE(),
			        IsMonthSelected,
			            CALCULATE(
			                [EnqToTour Conversion Rate],
			                DATEADD(_Date[Date], -1, YEAR),
			                VALUES(_Date[Month])
			            ),
			        IsQuarterSelected,
			            CALCULATE(
			                [EnqToTour Conversion Rate],
			                DATEADD(_Date[Date], -1, YEAR),
			                VALUES(_Date[Fiscal Quarter])
			            ),
			        IsYearSelected,
			            CALCULATE(
			                [EnqToTour Conversion Rate],
			                DATEADD(_Date[Date], -1, YEAR)
			            ),
			        BLANK()
			    )
			
			RETURN
			DIVIDE(ThisPeriodTours - LastPeriodTours, LastPeriodTours, 0)
		lineageTag: eb66d9d9-a7e2-42d2-8200-6496d866a6b9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EnqToTour Conversion Average' =
			
