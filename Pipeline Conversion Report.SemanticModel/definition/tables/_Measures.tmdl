	measure 'Count Tours Scheduled (Enquired)' = ```
			
			VAR MinDate = MIN(_date[Date])
			VAR MaxDate = MAX(_date[Date])
			
			RETURN 
			CALCULATE(
			    DISTINCTCOUNT(LineLeader_Updates[family_id]),
			    LineLeader_Updates[to] = "11",
			    LineLeader_Updates[type] = "Status",
			    NOT(ISBLANK(LineLeader_Updates[EnquiryDate])),
			    LineLeader_Updates[EnquiryDate] >= MinDate,
			    LineLeader_Updates[EnquiryDate] <= MaxDate
			)
			
			
			```
		formatString: 0
		lineageTag: f7b5f6b9-7a31-4e2c-a345-cf7e6d8b9bb7

		changedProperty = IsHidden

	measure 'Tour Success Rate (%) Target' =
			
