	measure 'Conv''d Tour' =
			
			VAR SelectedType =
			    SELECTEDVALUE(ConversionSwitch[ConversionType], "Combined")
			RETURN
			SWITCH(
			    TRUE(),
			    SelectedType = "Enrolled",
			        [Conv'd Tour (Enrolled)],
			    SelectedType = "Waitlisted",
			        [Conv'd Tour (Waitlist)],
			    -- Default to Combined
			    [Conv'd Tour (combined)]
			) + 0
		formatString: 0
