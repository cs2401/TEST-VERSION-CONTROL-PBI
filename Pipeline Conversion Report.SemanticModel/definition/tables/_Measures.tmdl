	measure CompletedTours =
			
			VAR MinDate = MIN(_date[Date])
			VAR MaxDate = MAX(_date[Date])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(LineLeader_Updates[family_id]),
			    LineLeader_Updates[to] IN {"11", "3"},
			    LineLeader_Updates[type] = "Status",
			    NOT ISBLANK(LineLeader_Updates[Date Tour Completed (LLTasks)]),/*
			    USERELATIONSHIP(LineLeader_Updates[LatestTourAddedDate], _Date[Date])*/
			    LineLeader_Updates[Date Tour Completed (LLTasks)] >= MinDate,
			    LineLeader_Updates[Date Tour Completed (LLTasks)] <= MaxDate
			)
		formatString: 0
		lineageTag: add4100b-d73a-42d9-a854-2976a4f7d097

