	column 'Opportunity Won Date' =
			
			VAR result = INT( COALESCE( LineLeader_Enrollments[expected_start_date] , LineLeader_Enrollments[wait_list_date] , LineLeader_Enrollments[register_date] ) )
			RETURN
			IF( result >= TODAY(), TODAY() , result )
		dataType: dateTime
		formatString: Long Date
