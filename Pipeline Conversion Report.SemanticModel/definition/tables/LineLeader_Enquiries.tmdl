				    // Join to LineLeader_Families to access added_date
				    #"Merged Queries" = Table.NestedJoin(#"Filtered Rows", {"family_id"}, LineLeader_Families, {"family_id"}, "LineLeader_Families", JoinKind.LeftOuter),
				
				    // Expand center_id and added_date from the families table
				    #"Expanded LineLeader_Families" = Table.ExpandTableColumn(
				        #"Merged Queries",
				        "LineLeader_Families",
				        {"center_id", "added_date"},
				        {"LineLeader_Families.center_id", "LineLeader_Families.added_date"}
				    ),
				
				    // Ensure added_date is a date (strip time if present)
				    #"Cast added_date to date" = Table.TransformColumns(
				        #"Expanded LineLeader_Families",
				        {{"LineLeader_Families.added_date", DateTime.Date, type date}}
				    ),
				
				    // Use earliest added_date as FirstDate
				    #"Grouped Rows" = Table.Group(
				        #"Cast added_date to date",
				        {"family_id", "LineLeader_Families.center_id"},
				        {
				            {"Count", each Table.RowCount(_), Int64.Type},
				            {"FirstDate", each List.Min([LineLeader_Families.added_date]), type date}
				        }
				    ),
				
				    #"Removed Columns" = Table.RemoveColumns(#"Grouped Rows",{"Count"}),
				    #"Sorted Rows" = Table.Sort(#"Removed Columns",{{"FirstDate", Order.Ascending}})
				in
				    #"Sorted Rows"

