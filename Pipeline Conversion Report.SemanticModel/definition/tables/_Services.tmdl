	column 'Fully Qualified Name'
		dataType: string
		lineageTag: 72a6caae-d30b-4f7e-9fd5-5fd0adf6f9fd
		summarizeBy: none
		sourceColumn: Fully Qualified Name

		annotation SummarizationSetBy = Automatic

	column 'Conversion Flag' =
			
			VAR phrase = "village early learning"
			VAR cname   = LOWER ( TRIM ( _Services[Full name] ) )
			RETURN
			IF ( LEFT ( cname, LEN ( phrase ) ) = phrase, 1, 0 )
		formatString: 0
		lineageTag: f4dc3ccd-74c7-41a4-87d8-83035b6907d4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition _Services = m
		mode: import
		queryGroup: Combined
		source = ```
				let
				    Source = Sql.Database("yourdatahubececservicesptyltd.database.windows.net", "yourdatahub_ececservicesptyltd", [
				        Query = "
				            SELECT 
				                l.[locationId] AS [LocationID_KP], 
				                l.externalId, 
				                l.[parentId] AS [ParentId],
				                l.LastUpdatedDateTimeUtc, 
				                CASE
				                    WHEN l.fullyQualifiedName LIKE '%Claremont%' THEN 'Village Early Learning Claremont'
				                    WHEN l.fullyQualifiedName LIKE '%Karrinyup%' THEN 'Village Early Learning Karrinyup'
				                    WHEN l.fullyQualifiedName LIKE '%WSR%' THEN 'Kidz Biz Sport & Recreation Care - Wanneroo'
				                    WHEN l.fullyQualifiedName LIKE '%NSR%' THEN 'Kidz Biz Sport & Recreation Care - Nedlands'
				                    WHEN l.fullyQualifiedName LIKE '%BSR%' THEN 'Kidz Biz Sport & Recreation Care - Beaumaris'
				                    WHEN l.fullyQualifiedName LIKE '%HSR%' THEN 'Kidz Biz Sport & Recreation Care - Hollywood'
				                    ELSE s.name 
				                END AS [Full Name], 
				                COALESCE(
				                    REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(
				                        s.name,
				                        'Kidz Biz Sport & Recreation Care - Wanneroo', 'SR Wanneroo'),
				                        'Kidz Biz Sport & Recreation Care - Nedlands', 'SR Nedlands'),
				                        'Kidz Biz Sport & Recreation Care - Beaumaris', 'SR Beaumaris'),
				                        'Kidz Biz Sport & Recreation Care - Hollywood', 'SR Hollywood'),
				                        'Kidz Biz Sport & Recreation Care - ', ''),
				                        'Kidz Biz on ', ''),
				                        'Kidz Biz Early Learning Centre - ', ''),
				                        'Village Early Learning ', ''),
				                        'Village Before & Beyond ', ''
				                    ), s.name) AS [Short Name],
				                l.fullyQualifiedName AS [Fully Qualified Name], 
				                COALESCE(NULLIF(k2.[LocationId], ''), l.[LocationId]) AS [ServiceID_KP], 
				                CASE
				                    WHEN l.fullyQualifiedName LIKE '%Claremont%' THEN 'Village Early Learning Claremont'
				                    WHEN l.fullyQualifiedName LIKE '%Karrinyup%' THEN 'Village Early Learning Karrinyup'
				                    WHEN l.fullyQualifiedName LIKE '%WSR%' THEN 'Kidz Biz Sport & Recreation Care - Wanneroo'
				                    WHEN l.fullyQualifiedName LIKE '%NSR%' THEN 'Kidz Biz Sport & Recreation Care - Nedlands'
				                    WHEN l.fullyQualifiedName LIKE '%BSR%' THEN 'Kidz Biz Sport & Recreation Care - Beaumaris'
				                    WHEN l.fullyQualifiedName LIKE '%HSR%' THEN 'Kidz Biz Sport & Recreation Care - Hollywood'
				                    ELSE s.name 
				                END AS [KeyPayKiosks.name],
				                CASE 
				                    WHEN CHARINDEX('-', REVERSE(REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood'))) > 0 THEN 
				                        REVERSE(
				                            LEFT(REVERSE(REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood')), 
				                            CHARINDEX('-', REVERSE(REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood'))) - 1)
				                        )
				                    ELSE 
				                        CASE 
				                            WHEN CHARINDEX('/', REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood')) > 0 THEN 
				                                REVERSE(
				                                    LEFT(REVERSE(REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood')), 
				                                    CHARINDEX('/', REVERSE(REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood'))) - 1)
				                                )
				                            ELSE l.name 
				                        END
				                END AS [Location Name],
				                CASE 
				                    WHEN l.fullyQualifiedName LIKE '%WSR%' THEN 'abe47aaa-7d86-4c9d-bbf8-2b4a8ae68685' 
				                    ELSE s.ServiceID 
				                END AS [ServiceID_KS],
				                ll.center_id AS [ServiceId_LL]
				            FROM 
				                [KeyPayLocations] AS l 
				            FULL OUTER JOIN KidsoftServices AS s ON
				                CASE 
				                    WHEN CHARINDEX('/ ', REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood')) > 0 
				                        AND CHARINDEX(' /', REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood'), CHARINDEX('/ ', REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood')) + 2) > 0 
				                    THEN 
				                        SUBSTRING(
				                            REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood'),
				                            CHARINDEX('/ ', REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood')) + 2,
				                            CHARINDEX(' /', REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood'), CHARINDEX('/ ', REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood')) + 2)
				                            - (CHARINDEX('/ ', REPLACE(REPLACE(REPLACE(REPLACE(l.fullyQualifiedName, 'WSR', 'SR Wanneroo'), 'NSR', 'SR Nedlands'), 'BSR', 'SR Beaumaris'), 'HSR', 'SR Hollywood')) + 2)
				                        )
				                    ELSE l.name 
				                END = 
				                COALESCE(
				                    REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(
				                        s.name,
				                        'Kidz Biz Sport & Recreation Care - Wanneroo', 'SR Wanneroo'),
				                        'Kidz Biz Sport & Recreation Care - Nedlands', 'SR Nedlands'),
				                        'Kidz Biz Sport & Recreation Care - Beaumaris', 'SR Beaumaris'),
				                        'Kidz Biz Sport & Recreation Care - Hollywood', 'SR Hollywood'),
				                        'Kidz Biz Sport & Recreation Care - ', ''),
				                        'Kidz Biz on ', ''),
				                        'Kidz Biz Early Learning Centre - ', ''),
				                        'Village Early Learning ', ''),
				                        'Village Before & Beyond ', ''
				                    ), s.name)
				            LEFT JOIN LineLeaderCenters AS ll ON ll.name = s.name 
				            LEFT JOIN [KidsoftServices] AS s2 ON s.ServiceID = s2.ServiceID 
				            LEFT JOIN [KeyPayKiosks] AS k1 ON k1.name = s.name 
				            LEFT JOIN [KeyPayKiosks] AS k2 ON k2.locationId = l.locationId
				        "]),
				    #"Sorted Rows" = Table.Sort(Source,{{"Fully Qualified Name", Order.Ascending}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Sorted Rows","(A) ","",Replacer.ReplaceText,{"Location Name"}),
				    #"Capitalized Each Word" = Table.TransformColumns(#"Replaced Value",{{"Location Name", Text.Proper, type text}}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Capitalized Each Word","(B) ","",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","(C) ","",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","(D)","",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value3","(E) ","",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value5" = Table.ReplaceValue(#"Replaced Value4","(F) ","",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value6" = Table.ReplaceValue(#"Replaced Value5","(G) ","",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value7" = Table.ReplaceValue(#"Replaced Value6",".","",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value11" = Table.ReplaceValue(#"Replaced Value7","Ljbc","LJBC",Replacer.ReplaceText,{"KeyPayKiosks.name"}),
				    #"Filtered Rows1" = Table.SelectRows(#"Replaced Value11", each ([Short Name] <> "Support Office")),
				    #"Replaced Value8" = Table.ReplaceValue(#"Filtered Rows1","SR Wanneroo ","",Replacer.ReplaceText,{"Location Name"}),
				    #"Filtered Rows" = Table.SelectRows(#"Replaced Value8", each true),
				    #"Changed Type" = Table.TransformColumnTypes(#"Filtered Rows",{{"LocationID_KP", Int64.Type}, {"ParentId", Int64.Type}, {"ServiceID_KP", Int64.Type}}),
				    #"Replaced Value9" = Table.ReplaceValue(#"Changed Type","Afterschool","After School",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value10" = Table.ReplaceValue(#"Replaced Value9","Boo ","Book ",Replacer.ReplaceText,{"Location Name"}),
				    #"Trimmed Text1" = Table.TransformColumns(Table.TransformColumnTypes(#"Replaced Value10", {{"ServiceID_KP", type text}, {"LastUpdatedDateTimeUtc", type text}, {"ParentId", type text}, {"LocationID_KP", type text}}, "en-AU"),{{"ServiceID_KS", Text.Trim, type text}, {"Location Name", Text.Trim, type text}, {"KeyPayKiosks.name", Text.Trim, type text}, {"ServiceID_KP", Text.Trim, type text}, {"Fully Qualified Name", Text.Trim, type text}, {"Short Name", Text.Trim, type text}, {"Full Name", Text.Trim, type text}, {"LastUpdatedDateTimeUtc", Text.Trim, type text}, {"ParentId", Text.Trim, type text}, {"externalId", Text.Trim, type text}, {"LocationID_KP", Text.Trim, type text}}),
				    #"Replaced Value12" = Table.ReplaceValue(#"Trimmed Text1","Sr Wanneroo ","",Replacer.ReplaceText,{"Location Name"}),
				    #"Sorted Rows1" = Table.Sort(#"Replaced Value12",{{"Short Name", Order.Ascending}})
				in
				    #"Sorted Rows1"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

