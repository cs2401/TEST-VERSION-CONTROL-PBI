		annotation SummarizationSetBy = Automatic

	column Join =
			
			SWITCH (
			    TRUE(),
			    _Services[Short Name] = "Beaumaris" && _Services[Location Name] = "Babies", "BeaumarisAdventurers",
			    _Services[Short Name] = "Beaumaris" && _Services[Location Name] = "Toddlers 1", "BeaumarisBuilders",
			    _Services[Short Name] = "Beaumaris" && _Services[Location Name] = "Toddlers 2", "BeaumarisCreators",
			    _Services[Short Name] = "Beaumaris" && _Services[Location Name] = "Pre Kindy", "BeaumarisDiscoverers",
			    _Services[Short Name] = "Beaumaris" && _Services[Location Name] = "Kindy", "BeaumarisExplorers",
			    _Services[Short Name] = "Dianella" && _Services[Location Name] = "Pre Kindy", "DianellaPrKindy",
			    _Services[Short Name] = "Wanneroo" && _Services[Location Name] = "Wanneroo", "WannerooKindy",
			    _Services[Short Name] = "Wanneroo" && _Services[Location Name] = "Pre Kindy", "WannerooPrKindy",
			    _Services[Short Name] = "Nedlands" && _Services[Location Name] = "Vacation Care", "NedlandsPupil Free",
			    _Services[Short Name] = "Hollywood" && _Services[Location Name] = "After School Care", "HollywoodAfter School Care",
			    _Services[Short Name] = "Beaconsfield" && _Services[Location Name] = "After School Care", "BeaconsfieldAfter School Care",
			    _Services[Short Name] = "WSR" && _Services[Location Name] = "Sr Wanneroo", "Sr WannerooSr Wanneroo",
			    _Services[Short Name] & _Services[Location Name] )
		lineageTag: c9c466cd-4aaa-4db9-a050-95e147817eb4
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Location Name'
		dataType: string
		lineageTag: 40bd7a82-1799-411a-89e7-4baca2143fcc
		summarizeBy: none
		sourceColumn: Location Name

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column RoomID = ```
			
			    CALCULATE (
			        FIRSTNONBLANK ( KS_Rooms[RoomID], 1 ),
			        FILTER ( KS_Rooms, KS_Rooms[Join] = _Services[Join] && KS_Rooms[Active] = "Yes")
			    )
			```
		lineageTag: e4395e50-e9b4-41bb-83f9-73b8386a40ac
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column ServiceCombinedKey = ```
			
			VAR result = 
			    VAR KS = 
			    LEFT('_Services'[ServiceID_KS], 6) &
			    LEFT('_Services'[RoomID], 6 ) 
			    VAR KP =
			    LEFT ( _Services[ServiceID_KP], 6 ) &
			    LEFT ( _Services[LocationId_KP] )
			    RETURN
			   COALESCE ( KS , KP )
			RETURN
			SWITCH( TRUE() ,
			    _Services[ServiceID_KS] = "08c294a8-3b2e-4eaa-8627-69f89161c429" && //beaconsfield edge case
			    NOT ( _Services[RoomID] IN {"2d513f9d-1452-420e-bcd3-787e6196f746", "667bda38-be8e-4984-9759-7da84ff0747b"} ),
			    "12345", 
			    _Services[ServiceID_KS] = "abe47aaa-7d86-4c9d-bbf8-2b4a8ae68685" && _Services[RoomID] = "af52dc9d-ca17-4a6a-8d88-d9b009df99c9" , //wanneroo edge case
			    LEFT( _Services[RoomID], 6 ) ,
			    result
			)
			```
		lineageTag: c643b2c0-ea01-400d-bc01-3ba31a5c1084
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Care Type' = ```
			
			VAR CareType = LOOKUPVALUE(KS_Rooms[ApprovalType], KS_Rooms[Join], _Services[Join] )
			RETURN
			SWITCH (
			    TRUE(),
			    NOT ( CareType IN { BLANK(), "LDC" } ), "OSCH", 
			    _Services[Location Name] IN { "After School Care", "Before School Care", "Vacation Care" }, "OSCH",
			    _Services[RoomID] = BLANK() && CONTAINSSTRING(_Services[Full Name], "Early Learning") && _Services[Location Name] <> "Support", "LDC",
			    CareType 
			)
			```
		lineageTag: 3c323dc9-698f-49d5-9b85-9a1147deb4a7
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

