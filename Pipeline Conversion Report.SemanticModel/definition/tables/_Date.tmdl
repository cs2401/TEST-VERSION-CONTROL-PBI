	column isPast =
			
			IF ( _Date[End of Week] < TODAY(), 1, 0 )
		formatString: 0
		lineageTag: 140ff629-cccb-4692-a880-cbe343e1661a
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column isUpTo3MonthsFromToday =
			
			VAR _3MonthsFromToday = EDATE ( TODAY(), 3 )
			RETURN
			IF ( _Date[Date] <= _3MonthsFromToday, 1, 0 )
		formatString: 0
		lineageTag: e9a467e2-cd72-4159-9fc1-14bee03ac232
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column isCurrentWeek =
			
			VAR _startOfWeek = LOOKUPVALUE(_Date[Start of Week], _Date[Date], TODAY() )
			VAR _endOfWeek = LOOKUPVALUE(_Date[End of Week], _Date[Date], TODAY() )
			RETURN
			IF ( _Date[Date] >= _startOfWeek && _Date[Date] <= _endOfWeek, 1, 0 )
		formatString: 0
		lineageTag: 57a75a24-2295-4586-a287-b98941846ac4
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Week Ending Slicer' = IF ( _Date[isCurrentWeek] = 1, "Current Week", FORMAT ( _Date[End of Week], "DD-MMM-YYYY"))
		lineageTag: 63aecc44-e117-4565-890a-df98f73c6e86
		summarizeBy: none
		sortByColumn: 'End of Week'

		changedProperty = SortByColumn

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column isCurrentMonth =
			
			VAR _startOfMonth= LOOKUPVALUE(_Date[Start of Month], _Date[Date], TODAY() )
			VAR _endOfMonth = LOOKUPVALUE(_Date[End of Month], _Date[Date], TODAY() )
			RETURN
			IF ( _Date[Date] >= _startOfMonth && _Date[Date] <= _endOfMonth, 1, 0 )
		formatString: 0
		lineageTag: d1baf70a-126b-4513-b63d-fb3bf17dee96
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Month Slicer' = IF ( _Date[isCurrentMonth] = 1, "Current Month", FORMAT(_Date[Year-Month], "MMM YYYY") )
