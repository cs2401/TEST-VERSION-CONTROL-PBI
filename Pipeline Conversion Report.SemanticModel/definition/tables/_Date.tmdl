	column NextWeekDay = ```
			
			VAR CurrentDay = WEEKDAY(_Date[Date], 2) // Monday = 1, Sunday = 7
			RETURN 
			    IF(CurrentDay = 5, _Date[Date] + 3, _Date[Date] + 1)
			```
		formatString: General Date
		lineageTag: 5c8e7f5f-e4a4-404a-8876-22824adb41fa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column PreviousDay = ```
			
			VAR CurrentDay = WEEKDAY(_Date[Date], 2) // Monday = 1, Sunday = 7
			RETURN 
			    IF(CurrentDay = 1, _Date[Date] - 3, _Date[Date] - 1)
			```
		formatString: General Date
		lineageTag: 7c1c5206-010e-4b3d-a274-3d2b301f5734
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Fiscal Year Name' = "FY" & RIGHT( _Date[Fiscal Year] , 2 )
