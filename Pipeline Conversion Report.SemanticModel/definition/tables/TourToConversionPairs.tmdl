	column Centre = lookupvalue(LineLeader_Updates[Centre], LineLeader_Updates[family_id], TourToConversionPairs[family_id_tour])
		lineageTag: ef9017b4-aad6-48d3-8848-3213ba89825b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition TourToConversionPairs = calculated
		mode: import
		source =
				
				VAR MinDate = MIN(_Date[Date])
				VAR MaxDate = MAX(_Date[Date])
				
				VAR RawPairs =
				    FILTER (
				        ADDCOLUMNS (
				            CROSSJOIN (
				                // Scheduled Tours
				                SELECTCOLUMNS (
				                    FILTER (
				                        'LineLeader_Updates',
				                        'LineLeader_Updates'[type] = "Status" &&
				                        --'LineLeader_Updates'[to] = "4" &&
				                        Not(Isblank('LineLeader_Updates'[LatestTourAddedDate]))
				                    ),
				                    "family_id_tour", [family_id],
				                    "tour_date", [LatestTourAddedDate],  -- Renamed for clarity
				                    "RejectedFilter", [DateRejected]
				                ),
				                // Conversions
				                SELECTCOLUMNS (
				                    FILTER (
				                        'LineLeader_Updates',
				                        'LineLeader_Updates'[type] = "Status" &&
				                        'LineLeader_Updates'[to] IN {"4", "6"} &&
				                        NOT(ISBLANK('LineLeader_Updates'[LatestTourAddedDate])) &&
				                        'LineLeader_Updates'[LatestTourAddedDate] >= MinDate &&
				                        'LineLeader_Updates'[LatestTourAddedDate] <= MaxDate
				                    ),
				                    "family_id_conv", [family_id],
				                    "DT2_conv", [Date Enrolled]
				                )
				            ),
				            "DaysElapsed", DATEDIFF([tour_date], [DT2_conv], DAY),
				            "Financial Year",
				                "FY" & FORMAT(
				                    YEAR([tour_date]) + IF(MONTH([tour_date]) >= 7, 1, 0),
				                    "0000"
				                )
				        ),
				        [family_id_tour] = [family_id_conv] &&
				        [DT2_conv] >= [tour_date]
				    )
				
				RETURN
				SUMMARIZE (
				    RawPairs,
				    [family_id_tour],
				    [family_id_conv],
				    [tour_date],
				    [DT2_conv],
				    [RejectedFilter],
				    [DaysElapsed],
				    [Financial Year]
				)

	annotation PBI_Id = b9288b9f17794b7894cf0031fcba9260

