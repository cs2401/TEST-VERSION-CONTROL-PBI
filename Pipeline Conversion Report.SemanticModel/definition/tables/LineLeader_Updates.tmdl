	column Centre = ```
			
			VAR LocationKey = LineLeader_Updates[Family_Location]
			RETURN
			IF (
			    ISBLANK(LocationKey),
			    BLANK(),  // or "Unknown", "Unmapped", etc.
			    LOOKUPVALUE(
			        _Services[Short Name],
			        _Services[ServiceId_LL],
			        LocationKey
			    )
			)
			
