	column LatestTourAddedDate =
			
			VAR CurrentFamilyID = LineLeader_Updates[family_id]
			RETURN
			CALCULATE(
			    MIN(LineLeader_Tasks[completed_date_time]),
			    FILTER(
			        LineLeader_Tasks,
			        LineLeader_Tasks[family_id] = CurrentFamilyID
			            && LineLeader_Tasks[type_value] = "Tour"
			            &&LineLeader_Tasks[is_completed] = TRUE()
			    )
			)
		formatString: General Date
		lineageTag: b0cb1281-4a6f-42c6-976d-8185fd22ddf0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HasCompletedTour = ```
			
			VAR CurrentFamilyID = LineLeader_Updates[family_id]
			RETURN
			IF (
			    COUNTROWS (
			        FILTER (
			            LineLeader_Tasks,
			            LineLeader_Tasks[family_id] = CurrentFamilyID
			                && LineLeader_Tasks[type_value] = "Tour"
			        )
			    ) > 0,
			    1,
			    0
			) 
			```
		formatString: 0
		lineageTag: 98db2f0f-d38b-42e7-b204-c5399b176d28
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Date Tour Completed (LLTasks)' =
			
			VAR CurrentFamilyID = LineLeader_Updates[family_id]
			RETURN
			CALCULATE(
			    MIN(LineLeader_Tasks[completed_date_time]),
			    FILTER(
			        LineLeader_Tasks,
			        LineLeader_Tasks[family_id] = CurrentFamilyID
			            && LineLeader_Tasks[type_value] = "Tour"
			            &&LineLeader_Tasks[is_completed] = TRUE()
			    )
			)
		formatString: Short Date
		lineageTag: 916856a0-d5e0-4a7f-b649-c33194b60044
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Date Enrolled' =
			
			CALCULATE(
			    MAX(LineLeader_Updates[field_changes_date_time]),
			    FILTER(
			        LineLeader_Updates,
			        LineLeader_Updates[family_id] = EARLIER(LineLeader_Updates[family_id])
			            && LineLeader_Updates[child_id] = EARLIER(LineLeader_Updates[child_id])
			            && LineLeader_Updates[type] = "Status"
			            && LineLeader_Updates[to] IN {"6", "4"}
			    )
			)
		formatString: Short Date
		lineageTag: fa9f860e-4a10-4409-84e3-a6beace12221
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Date Tour Scheduled' =
			
			CALCULATE(
			    MIN(LineLeader_Updates[field_changes_date_time]),
			    FILTER(
			        LineLeader_Updates,
			        LineLeader_Updates[family_id] = EARLIER(LineLeader_Updates[family_id])
			            && LineLeader_Updates[child_id] = EARLIER(LineLeader_Updates[child_id])
			            && LineLeader_Updates[type] = "Status"
			            && LineLeader_Updates[to] = "11"
			    )
			)
		formatString: Short Date
		lineageTag: bda58ad5-867d-4012-9064-545a2aa48851
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

