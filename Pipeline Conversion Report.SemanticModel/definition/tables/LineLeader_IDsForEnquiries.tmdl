	column Centre =
			
			VAR LocationKey = LineLeader_IDsForEnquiries[center_id]
			RETURN
			IF (
			    ISBLANK(LocationKey),
			    BLANK(),  // or "Unknown", "Unmapped", etc.
			    LOOKUPVALUE(
			        _Services[Short Name],
			        _Services[ServiceId_LL],
			        LocationKey
			    )
			)
