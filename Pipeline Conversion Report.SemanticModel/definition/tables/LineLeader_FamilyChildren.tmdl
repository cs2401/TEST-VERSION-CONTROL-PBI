	column 'Age Group' = ```
			
			VAR ageInMonths = DATEDIFF('LineLeader_FamilyChildren'[date_of_birth], TODAY(), MONTH )
			RETURN
			SWITCH ( 
			    TRUE(),
			    ageInMonths < 24, "0-24",
			    ageInMonths >= 24 && ageInMonths < 36, "24-36",
			    ageInMonths >= 36, "36+",
			    BLANK()
			)
			```
		lineageTag: e727a683-2d17-4f0f-9dbf-4b5cce6d1cf2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

