	column 'Source Category' =
			
			VAR s = LOWER ( TRIM ( LineLeader_Families[source_type_value] ) )
			RETURN
			SWITCH (
			    TRUE (),
			    LEFT ( s, 13 ) = "word of mouth" || s = "friend/family",            "Referral",
			    CONTAINSSTRING ( s, "signage" ),                                    "Signage",
			    s = "google search" || s = "google",                                "Google",
			    s IN { "facebook", "instagram", "social media" },                   "Social Media",
			    s = "care for kids",                                                "Care For Kids",
			    s = "event",                                                        "Events",
			    s = "flyer",                                                        "Flyer",
			    s = "phone call",                                                   "Phone Call",
			    s = "import",                                                       "Import",
			    s in {"other", BLANK(), "unknown", "(Blank)"},                             "Other",
			    "Other"
			)
		lineageTag: bd750857-62be-4c97-be2a-8f546e5c2154
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'No Update Flag' =
			
			VAR fid = LineLeader_Families[family_id]
			VAR Matches =
			    COUNTROWS (
			        FILTER (
			            LineLeader_Updates,
			            LineLeader_Updates[family_id] = fid
			                && LineLeader_Updates[type] = "Status"
			                && VALUE ( TRIM ( LineLeader_Updates[to] ) ) IN {4, 6 }
			        )
			    )
			RETURN
			IF ( Matches = 0, 1, 0 )
		formatString: 0
		lineageTag: 429e5435-62fb-4c29-bc08-748f7b96712f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Child Name' = ```
			
			VAR ChildrenForFamily =
			    FILTER (
			        LineLeader_FamilyChildren,
			        LineLeader_FamilyChildren[family_id] = LineLeader_Families[family_id]
			    )
			VAR EnrichedChildren =
			    ADDCOLUMNS (
			        ChildrenForFamily,
			        "_Full", LineLeader_FamilyChildren[name],
			        // First = text before first space (or whole name if single-token)
			        "_First",
			            VAR _n = LineLeader_FamilyChildren[name]
			            VAR _pos = FIND ( " ", _n & " ", 1, 0 )
			            RETURN IF ( _pos = 0, _n, LEFT ( _n, _pos - 1 ) ),
			        // Last = text after last space (blank if single-token)
			        "_Last",
			            VAR _n = LineLeader_FamilyChildren[name]
			            VAR _spaces = LEN ( _n ) - LEN ( SUBSTITUTE ( _n, " ", "" ) )
			            VAR _lastPos =
			                FIND ( "|", SUBSTITUTE ( _n, " ", "|", _spaces ), 1, 0 )
			            RETURN IF ( _lastPos = 0, BLANK (), RIGHT ( _n, LEN ( _n ) - _lastPos ) )
			    )
			VAR FirstTwo =
			    TOPN ( 2, EnrichedChildren, [_Full], ASC )
			VAR ChildCount = COUNTROWS ( FirstTwo )
			
			// deterministically pick row 1 and row 2 by [_Full] ascending
			VAR Row1 = TOPN ( 1, FirstTwo, [_Full], ASC )
			VAR Row2 = EXCEPT ( FirstTwo, Row1 )
			
			VAR C1_First = MAXX ( Row1, [_First] )
			VAR C1_Last  = MAXX ( Row1, [_Last] )
			VAR C1_Full  = MAXX ( Row1, [_Full] )
			
			VAR C2_First = MAXX ( Row2, [_First] )
			VAR C2_Last  = MAXX ( Row2, [_Last] )
			VAR C2_Full  = MAXX ( Row2, [_Full] )
			
			// NEW: consider duplicates; EXCEPT can drop a duplicate row, leaving Row2 empty
			VAR DedupSameFullName =
			    ChildCount >= 2 && ( ISBLANK ( C2_Full ) || C1_Full = C2_Full )
			
			VAR SameLast = NOT ISBLANK ( C1_Last ) && C1_Last = C2_Last
			
			RETURN
			SWITCH (
			    TRUE (),
			    ChildCount = 0, BLANK (),
			    ChildCount = 1, C1_Full,
			    DedupSameFullName, C1_Full,                                 // <-- fix trailing " & "
			    SameLast, C1_First & " & " & C2_First & " " & C1_Last,
			    C1_Full & " & " & C2_Full
			)
			
			```
		lineageTag: 7cfcbbf2-f431-4391-96d1-c9c3b4fc42fa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

